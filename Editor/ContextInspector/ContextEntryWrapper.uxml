<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(88, 88, 88); border-right-color: rgb(88, 88, 88); border-top-color: rgb(88, 88, 88); border-bottom-color: rgb(88, 88, 88); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; flex-wrap: wrap;">
            <ui:Label text="title" name="titleLabel" style="white-space: normal; flex-grow: 1; flex-shrink: 1;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="title" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:Toggle label="" value="false" name="enabledToggle">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="enabled" binding-mode="TwoWay"/>
                </Bindings>
            </ui:Toggle>
        </ui:VisualElement>
        <ui:Foldout text="Content" enabled="true" value="false" name="contentFoldout">
            <ui:Label text="content" name="contentLabel" style="white-space: normal;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="Content" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
